<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" Width="800" Height="450" x:Class="DialogueHelper.Views.Settings" Opened="OnOpened" Title="Settings">
    <Panel>
        <TabControl Margin="5">
            <TabItem Header="Style">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="7">Selected Background*</TextBlock>
                        <ComboBox Name="BackgroundComboBox" SelectedIndex="0">
                            <ComboBoxItem>Background by Author</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Foreground="LightCoral" Margin="5" TextWrapping="Wrap">
                        <Span FontWeight="Bold">Warning: </Span>
                        Ensure that the styles you use come from a <Span FontWeight="Bold">Trustworthy</Span> author, to ensure the safety of your system.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="7">Selected Style*</TextBlock>
                        <ComboBox Name="StyleComboBox" SelectedIndex="0">
                            <ComboBoxItem>Style by Author</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="Custom settings" Margin="5" />
                    <StackPanel Name="CustomSettingsPanel" Margin="5 0 0 0" />
                    <TextBlock Name="CustomSettingsNone" Foreground="Gray" Text="None" Margin="5 0 0 0" />
                </StackPanel>
            </TabItem>
            <!-- Git is not yet done, so disable it from the settings for now -->
            <TabItem Header="Git" IsVisible="False">
                <StackPanel Orientation="Vertical">
                    <CheckBox Name="EnableGit">Enable git</CheckBox>
                    <StackPanel Orientation="Vertical" Margin="5" IsVisible="{Binding #EnableGit.IsChecked}">
                        <TextBlock Foreground="LightCoral">
                            <Span FontWeight="Bold">Warning: </Span>
                            You must have git installed and set in your environment settings to be able to use this option.
                        </TextBlock>
                        <TextBlock Margin="0 5 0 0">Repository URL*</TextBlock>
                        <TextBox Name="RepoUrl" Margin="0 10 0 0" MaxHeight="0" PlaceholderText="https://github.com/user/repo.git" />
                        <TextBlock Margin="0 7 0 0">Selected Branch</TextBlock>
                        <TextBox Name="SelectedBranch" ToolTip.Tip="Leave this value empty to select the default/current branch" Margin="0 10 0 0" MaxHeight="0" PlaceholderText="main" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Author">
                <StackPanel Orientation="Vertical">
                    <TextBlock Margin="0 5 0 0">Author Name*</TextBlock>
                    <TextBox Name="AuthorName" Margin="0 10 0 0" MaxHeight="0" PlaceholderText="Your Name" />
                    <TextBlock Margin="0 7 0 0">Author Groups</TextBlock>
                    <TextBox Name="AuthorGroup" ToolTip.Tip="Leave this value empty to select all groups" Margin="0 10 0 0" MaxHeight="0" PlaceholderText="Group1,Group2, ..." />
                    <CheckBox Name="GroupOnlyEntries">Only show entries inside author groups</CheckBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Dictionaries">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0 7 0 0">
                        <TextBlock Text="Dictionary .aff path (relative to " />
                        <Button Click="OpenDictionariesRepo_OnClick" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="LibreOffice/dictionaries" TextDecorations="Underline" Foreground="#4EA1F7" />
                        </Button>
                        <TextBlock Text=")" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                        <TextBox Name="AffPathBox" Width="200" PlaceholderText="en/en_US.aff" TextChanged="PathBox_OnTextChanged" />
                        <TextBlock Name="AffStatusIcon" Text="✓" Foreground="LimeGreen" FontWeight="Bold" Margin="8 0 0 0" IsVisible="False" ToolTip.Tip="Already downloaded" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 7 0 0">
                        <TextBlock Text="Dictionary .dic path (relative to " />
                        <Button Click="OpenDictionariesRepo_OnClick" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="LibreOffice/dictionaries" TextDecorations="Underline" Foreground="#4EA1F7" />
                        </Button>
                        <TextBlock Text=")" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                        <TextBox Name="DicPathBox" Width="200" PlaceholderText="en/en_US.dic" TextChanged="PathBox_OnTextChanged" />
                        <TextBlock Name="DicStatusIcon" Text="✓" Foreground="LimeGreen" FontWeight="Bold" Margin="8 0 0 0" IsVisible="False" ToolTip.Tip="Already downloaded" />
                    </StackPanel>
                    
                    <Button Name="DownloadDictionaryButton" Content="Download dictionary files" Click="DownloadDictionary_OnClick" Margin="0 10 0 0" />
                    <TextBlock Name="DownloadStatusText" Margin="0 5 0 0" Text="" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Editor">
                <StackPanel Orientation="Vertical">
                    <TextBlock Margin="0 10 0 0">Editor Font</TextBlock>
                    <ComboBox Name="UiFontComboBox" Margin="0 5 0 0" HorizontalAlignment="Stretch" />
                    <TextBlock Margin="0 10 0 0">Editor Font Size (default: 14)</TextBlock>
                    <NumericUpDown Name="UiFontSizeBox" Margin="0 5 0 0" Minimum="6" Maximum="72" Value="14" FormatString="0" />
                    <CheckBox Name="SwapPreviewsCheckBox" ToolTip.Tip="Resizing is a little buggy for now" Margin="0 10 0 0">Swap Original/Editable previews</CheckBox>
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
            <Button Click="Ok_OnClick">OK</Button>
            <Button Click="Cancel_OnClick" Margin="5 0 0 0">Cancel</Button>
        </StackPanel>
    </Panel>
</Window>