<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <Authors>ryi3r</Authors>
        <Copyright>ryi3r 2025-2026</Copyright>
        <PackageId>Dialogue Helper</PackageId>
        <Product>Dialogue Helper</Product>
        <AssemblyVersion>2.1</AssemblyVersion>
        <FileVersion>2.1</FileVersion>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.0" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.0" />
        <PackageReference Include="CS-Script" Version="4.14.6" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Styles/**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Remove="Styles/Deltarune/UndertaleModCli/**" />
        <Content Include="Styles/Deltarune/UndertaleModCli/**/*.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Remove="Styles/Deltarune/UndertaleModCli/**/LICENSE.txt" />
        <Content Remove="Styles/Deltarune/UndertaleModCli/**/README.txt" />
        <Content Include="LICENSE">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>

        <Compile Remove="Styles/**" />
        <Compile Include="Styles/**/*.cs" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>
</Project>