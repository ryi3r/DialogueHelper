<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <Authors>ryi3r</Authors>
        <Copyright>ryi3r 2025-2026</Copyright>
        <PackageId>Dialogue Helper</PackageId>
        <Product>Dialogue Helper</Product>
        <AssemblyVersion>2.3</AssemblyVersion>
        <FileVersion>2.3</FileVersion>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="Avalonia.SpellChecker/**/*" />
        <AvaloniaXaml Remove="Avalonia.SpellChecker/**/*" />
        <ProjectReference Include="Avalonia.SpellChecker/Avalonia.SpellChecker/Avalonia.SpellChecker.csproj" />
        <PackageReference Include="Avalonia" Version="12.1.0" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
        <PackageReference Include="CS-Script" Version="4.14.11" />
        <PackageReference Include="SkiaSharp" Version="3.119.4" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="Styles/**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Backgrounds/**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="SpellCheckDictionaries/**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>

        <Content Remove="Styles/Deltarune/UndertaleModCli/**" />
        <Content Include="Styles/Deltarune/UndertaleModCli/**/*.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Remove="Styles/Deltarune/UndertaleModCli/**/LICENSE.txt" />
        <Content Remove="Styles/Deltarune/UndertaleModCli/**/README.txt" />
        <Content Include="LICENSE">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Compile Remove="Styles/**" />
        <Compile Include="Styles/**/*.cs" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>
    <Target Name="CleanDirs" AfterTargets="Build;Publish">
        <RemoveDir Directories="$(OutDir)/Dictionaries" />
        <RemoveDir Directories="$(PublishDir)/Dictionaries" />
    </Target>
</Project>